; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OceanBound"
config/description="A maritime sandbox: build your own boats from blocks and make a living on the water."
run/main_scene="res://world/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://systems/event_bus.gd"
InputSetup="*res://systems/input_setup.gd"
Waves="*res://systems/waves.gd"
BlockLibrary="*res://systems/block_library.gd"
ItemLibrary="*res://systems/item_library.gd"
Inventory="*res://systems/inventory.gd"
Economy="*res://systems/economy.gd"
Locations="*res://systems/locations.gd"
Jobs="*res://systems/jobs.gd"
GameState="*res://systems/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/size/window_width_override=2304
window/size/window_height_override=1296
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
